            "id": "UMAMI_WEB_PORT",
            "label": "Umami Web Port",
            "type": "port"
        },
        {
            "default": "umami",
            "description": "The database name for Umami.",
            "id": "POSTGRES_DB",
            "label": "PostgreSQL Database Name",
