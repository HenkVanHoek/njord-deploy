# NjordDeploy Environment Variables Template
# Copy this file to .env and adjust values for your environment.

# Container Engine (docker or podman)
CONTAINER_ENGINE="docker"

# AI Integration Provider (none, openai, gemini, anthropic, ollama, etc.)
AI_PROVIDER="none"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# Proxmox VE Hypervisor Integration
# Used for automated VM/LXC provisioning and template discovery.
PROXMOX_HOST="https://192.168.1.100:8006"
PROXMOX_NODE="pve"
PROXMOX_USER="root@pam"
PROXMOX_TOKEN_ID="root@pam!njorddeploy"
PROXMOX_TOKEN_SECRET=""

# Proxmox Default VM Credentials (Optional, for auto-configuration)
PROXMOX_VM_USER="debian"
PROXMOX_VM_PASSWORD=""
